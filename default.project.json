{
  "name": "Studio",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Packages": { "$path": "Packages", "$ignoreUnknownInstances": true }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" },
      "ServerPackages": { "$path": "ServerPackages", "$ignoreUnknownInstances": true }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Workspace": { "$ignoreUnknownInstances": true, "$properties": { "StreamingEnabled": true } }
  }
}
