{
  "name": "Studio",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Packages": { "$path": { "optional": "Packages" }, "$ignoreUnknownInstances": true }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" },
      "ServerPackages": { "$path": { "optional": "ServerPackages" }, "$ignoreUnknownInstances": true }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Workspace": { "$ignoreUnknownInstances": true, "$properties": { "StreamingEnabled": true } }
  }
}
