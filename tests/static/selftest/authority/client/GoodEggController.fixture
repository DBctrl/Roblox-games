-- qa selftest fixture: odds UI reads weights (no random), effects use random far from any weights.
local function oddsText(egg)
	local lines = {}
	for _, entry in egg.pets do
		table.insert(lines, string.format("%.2f%%", entry.weight / EconomyConfig.ODDS_TOTAL * 100))
	end
	return lines
end
